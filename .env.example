# ==========================================
# LIFEOS - Environment Configuration
# ==========================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="lifeos-super-secure-jwt-secret-key-production-change-this"

# Database (Default local SQLite; replace with PostgreSQL/Supabase for production)
DATABASE_URL="file:./dev.db"

# Optional: Supabase Connection (when deploying to cloud)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider (OpenAI / OpenRouter / DeepSeek compatible)
OPENAI_API_KEY="sk-not-configured"

# Payment: Stripe
STRIPE_SECRET_KEY="sk_test_not_configured"
STRIPE_WEBHOOK_SECRET="whsec_not_configured"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_not_configured"

# Payment: VNPay (Vietnam)
VNPAY_TMN_CODE="NOT_CONFIGURED"
VNPAY_HASH_SECRET="NOT_CONFIGURED"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# Payment: MoMo (Vietnam)
MOMO_PARTNER_CODE="MOMO_NOT_CONFIGURED"
MOMO_ACCESS_KEY="NOT_CONFIGURED"
MOMO_SECRET_KEY="NOT_CONFIGURED"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# Email Provider
EMAIL_SERVER="smtp://smtp.mailtrap.io:2525"
EMAIL_USER="your-email-user"
EMAIL_PASSWORD="your-email-password"
EMAIL_FROM="LifeOS <no-reply@lifeos.app>"
